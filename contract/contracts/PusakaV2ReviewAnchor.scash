pragma solidcash ^0.50.0;

// Each REVIEW round has an immutable NFT with bytes4(round) || bytes4(reviewSequence).
// Only an ACTIVE successor in the next round can spend it through owner cancellation.
contract PusakaV2ReviewAnchor(bytes32 planCategory, bytes20 ownerPkh) {
    function finalize() {
        require(this.activeInputIndex == 1, "anchor must be input 1");
        require(tx.inputs[0].tokenCategory == planCategory + 0x02, "input 0 must be plan minting NFT");
        require(tx.inputs[1].tokenCategory == planCategory, "anchor must hold plan none NFT");

        bytes commitment = tx.inputs[1].nftCommitment;
        require(commitment.length == 8, "invalid anchor commitment length");
        bytes seqBytes = commitment.split(4)[1];
        int reviewSequence = int(seqBytes);
        require(reviewSequence >= 4194305 && reviewSequence <= 4259839, "reviewSequence must be valid time-based BIP68");
        require(tx.version >= 2, "tx version must be >= 2 for BIP68 CSV");
        require(this.age >= reviewSequence, "review delay has not elapsed");
    }

    function cancel() {
        require(this.activeInputIndex == 1, "anchor must be input 1");
        require(tx.inputs[0].tokenCategory == planCategory + 0x02, "input 0 must be plan minting NFT");
        require(tx.inputs[1].tokenCategory == planCategory, "anchor must hold plan none NFT");
        require(tx.inputs.length >= 3, "owner co-spend input required");
        require(tx.inputs[2].lockingBytecode == new LockingBytecodeP2PKH(ownerPkh), "input 2 must be owner");
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "cancel must return to plan");
        require(tx.outputs[0].tokenCategory == planCategory + 0x02, "cancel must preserve plan minting NFT");

        bytes state = tx.inputs[0].nftCommitment;
        require(state.length == 51, "invalid plan commitment length");
        bytes header, bytes afterHeader = state.split(2);
        require(header == 0x0201, "cancel requires REVIEW");
        bytes round = afterHeader.split(4)[0];
        bytes marker = tx.inputs[1].nftCommitment;
        require(marker.length == 8, "invalid anchor commitment length");
        require(marker.split(4)[0] == round, "anchor round mismatch");

        int nextRound = int(round) + 1;
        require(nextRound > 0 && nextRound < 2147483647, "round overflow");
        bytes successor = tx.outputs[0].nftCommitment;
        require(successor.length == 51, "invalid successor commitment length");
        require(successor.split(7)[0] == 0x0200 + toPaddedBytes(nextRound, 4) + 0x00, "cancel requires next ACTIVE round with no approvals");
    }
}
