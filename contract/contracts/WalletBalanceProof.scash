pragma solidcash ^0.50.0;

// Stage 1 minimal wallet-balance proof contract.
// Keeps Pusaka v1 inheritance semantics while adding partial owner-authorized payments
// with protected change, atomic activity renewal, and permissionless inbox merging.
struct Heir {
    bytes20 pkh;
    int share;
}

event CheckedIn(int newDeadline);
event Distributed(int heirs, int pot);

contract WalletBalanceProof(bytes20 ownerPkh, int period, int totalShares, int feeBudget) {
    int public deadline;
    Heir[] public heirs;

    constructor(int firstDeadline, Heir[] initialHeirs) {
        require(int(initialHeirs.length) >= 1 && int(initialHeirs.length) <= 10, "1 to 10 heirs");
        this.heirs = initialHeirs;
        this.deadline = firstDeadline;
    }

    modifier ownerCoSpends() {
        require(tx.origin == new LockingBytecodeP2PKH(ownerPkh), "owner coin must be co-spent");
        _;
    }

    function checkIn() public ownerCoSpends {
        require(tx.locktime >= 500000000, "use a timestamp locktime");
        int nextDeadline = tx.locktime + period;
        if (nextDeadline > this.deadline) {
            this.deadline = nextDeadline;
        }
        emit CheckedIn(this.deadline);
    }

    function send(bytes recipientLock, int amount) public ownerCoSpends {
        require(tx.locktime >= 500000000, "use a timestamp locktime");
        require(amount >= 546, "amount below dust");
        require(this.balance >= amount, "insufficient protected balance");
        int remaining = this.balance - amount;
        require(remaining == 0 || remaining >= 576, "protected change below container dust");
        require(
            recipientLock.length == 25 || recipientLock.length == 23 || recipientLock.length == 35,
            "unsupported recipient script"
        );
        int nextDeadline = tx.locktime + period;
        if (nextDeadline > this.deadline) {
            this.deadline = nextDeadline;
        }
        this.transfer(recipientLock, amount);
    }

    function withdraw() public ownerCoSpends {
        this.transfer(new LockingBytecodeP2PKH(ownerPkh), this.balance);
    }

    function payHeir(int i, int pot) internal {
        if (i < int(this.heirs.length)) {
            this.transfer(new LockingBytecodeP2PKH(this.heirs[i].pkh), pot * this.heirs[i].share / totalShares);
        }
    }

    function distribute() public {
        require(tx.time >= this.deadline, "deadline has not passed");
        int pot = this.balance - feeBudget;
        payHeir(0, pot);
        payHeir(1, pot);
        payHeir(2, pot);
        payHeir(3, pot);
        payHeir(4, pot);
        payHeir(5, pot);
        payHeir(6, pot);
        payHeir(7, pot);
        payHeir(8, pot);
        payHeir(9, pot);
        emit Distributed(int(this.heirs.length), pot);
    }
}
