{
  "name": "pusaka-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mainnet": "tsc -b && vite build --mode mainnet",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:mainnet": "vite preview --mode mainnet",
    "test:wallet": "node --test scripts/wizard-signing.test.mjs",
    "postinstall": "patch-package",
    "build:pages": "tsc -b && vite build --mode pages && vite build --mode pages-chipnet",
    "test:ui": "playwright test",
    "sync:artifacts": "node scripts/sync-artifacts.mjs",
    "check:artifacts": "node scripts/sync-artifacts.mjs --check"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@cashlab/cauldron": "^1.0.3",
    "@cashlab/common": "^1.0.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@noble/curves": "^1.9.7",
    "@solidcash/solidc": "^0.50.0",
    "@solidcash/solidcash": "^0.50.1",
    "@wizardconnect/core": "^0.2.10",
    "@wizardconnect/dapp": "^0.2.7",
    "@wizardconnect/react": "^0.2.6",
    "lucide-react": "^1.73.0",
    "patch-package": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
