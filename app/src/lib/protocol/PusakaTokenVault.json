  "bytecode": "00c752798800ce78527e8800cd7b8800d17c527e8800d2527f75020200880376a9147c7e0288ac7e51c7788763516752c778876869c0ce827701209dc0cf008777 37b982a8 OP_DEFINE  c12fc38b OP_DEFINE 765102ff008d9301218001207f77010088 OP_1 OP_DEFINE OP_DEPTH OP_1SUB OP_ROLL OP_SIZE OP_4 OP_NUMEQUALVERIFY OP_INVOKE",
  "source": "pragma solidcash ^0.50.0;\r\n\r\n// Fungible CashTokens at this address follow the authenticated plan's live policy.\r\n// No NFT splitting, no fixed off-chain heir list, and no caller-chosen recipients.\r\ncontract PusakaTokenVault(bytes32 planCategory, bytes planLock, bytes20 ownerPkh) {\r\n    function ownerSpend() {\r\n        require(tx.inputs[0].lockingBytecode == planLock, \"bound plan required\");\r\n        require(tx.inputs[0].tokenCategory == planCategory + 0x02, \"plan identity\");\r\n        require(tx.outputs[0].lockingBytecode == planLock, \"plan successor\");\r\n        require(tx.outputs[0].tokenCategory == planCategory + 0x02, \"preserve identity\");\r\n        require(tx.outputs[0].nftCommitment.split(2)[0] == 0x0200, \"owner returns ACTIVE\");\r\n        bytes ownerLock = new LockingBytecodeP2PKH(ownerPkh);\r\n        require(tx.inputs[1].lockingBytecode == ownerLock || tx.inputs[2].lockingBytecode == ownerLock, \"owner signature required\");\r\n        require(tx.inputs[this.activeInputIndex].tokenCategory.length == 32, \"fungible tokens only\");\r\n        require(tx.inputs[this.activeInputIndex].nftCommitment == 0x, \"no NFT\");\r\n    }\r\n\r\n    function distribute(bytes policy) {\r\n        require(this.activeInputIndex == 1, \"one token receipt per payout\");\r\n        require(tx.inputs[0].lockingBytecode == planLock, \"bound plan required\");\r\n        require(tx.inputs[0].tokenCategory == planCategory + 0x02, \"plan identity\");\r\n        bytes state = tx.inputs[0].nftCommitment;\r\n        require(state.length == 51 && state.split(2)[0] == 0x0202, \"BCH claim must finish first\");\r\n        require(hash256(policy) == state.split(19)[1], \"live heir policy\");\r\n        require(policy.length >= 101 && policy.length <= 317, \"policy length\");\r\n        bytes category = tx.inputs[1].tokenCategory;\r\n        require(category.length == 32 && category != planCategory, \"foreign fungible category\");\r\n        require(tx.inputs[1].nftCommitment == 0x, \"no NFT\");\r\n        bytes totalBytes = policy.split(72)[1].split(4)[0];\r\n        bytes countBytes = policy.split(76)[1].split(1)[0];\r\n        int total = int(totalBytes);\r\n        int count = int(countBytes);\r\n        require(total > 0 && count > 0 && count <= 10, \"heir bounds\");\r\n        require(int(policy.length) == 77 + count * 24, \"canonical policy\");\r\n        require(int(tx.outputs.length) == count + 3, \"exact payout outputs\");\r\n        int amount = tx.inputs[1].tokenAmount;\r\n        int paid = 0;\r\n        int sum = 0;\r\n        for (int i = 0; i < count; i++) {\r\n            bytes entry = policy.split(77 + i * 24)[1];\r\n            bytes20 heir = unsafe_bytes20(entry.split(20)[0]);\r\n            bytes shareBytes = entry.split(20)[1].split(4)[0];\r\n            int share = int(shareBytes);\r\n            require(share > 0, \"positive share\");\r\n            int part = (amount * share) / total;\r\n            // Assign indivisible rounding units to the final configured heir.\r\n            if (i == count - 1) { part = amount - paid; }\r\n            require(tx.outputs[i + 1].lockingBytecode == new LockingBytecodeP2PKH(heir), \"fixed heir\");\r\n            if (part > 0) {\r\n                require(tx.outputs[i + 1].tokenCategory == category, \"correct token\");\r\n                require(tx.outputs[i + 1].tokenAmount == part, \"correct token share\");\r\n            } else {\r\n                require(tx.outputs[i + 1].tokenCategory == 0x, \"zero-share carrier only\");\r\n            }\r\n            require(tx.outputs[i + 1].nftCommitment == 0x, \"fungible payout\");\r\n            require(tx.outputs[i + 1].value >= 800, \"token carrier\");\r\n            paid = paid + part;\r\n            sum = sum + share;\r\n        }\r\n        require(sum == total, \"share total\");\r\n        int remainderIndex = count + 1;\r\n        require(tx.outputs[remainderIndex].lockingBytecode == tx.inputs[1].lockingBytecode, \"protected remainder\");\r\n        require(tx.outputs[remainderIndex].value >= tx.inputs[1].value, \"preserve token receipt BCH\");\r\n        if (paid < amount) {\r\n            require(tx.outputs[remainderIndex].tokenCategory == category, \"remainder category\");\r\n            require(tx.outputs[remainderIndex].tokenAmount == amount - paid, \"exact remainder\");\r\n            require(tx.outputs[remainderIndex].nftCommitment == 0x, \"fungible remainder\");\r\n        } else {\r\n            require(tx.outputs[remainderIndex].tokenCategory == 0x, \"no remainder token\");\r\n        }\r\n        for (int j = 2; j < int(tx.inputs.length); j++) {\r\n            require(tx.inputs[j].tokenCategory == 0x, \"sponsor BCH only\");\r\n        }\r\n        require(tx.outputs[count + 2].tokenCategory == 0x, \"sponsor change BCH only\");\r\n    }\r\n}\r\n",
