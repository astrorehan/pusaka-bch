  "source": "pragma solidcash ^0.50.0;\n\n// Each REVIEW round has an immutable NFT with bytes4(round) || bytes4(reviewSequence).\n// Only an ACTIVE successor in the next round can spend it through owner cancellation.\ncontract PusakaV2ReviewAnchor(bytes32 planCategory, bytes20 ownerPkh) {\n    function finalize() {\n        require(this.activeInputIndex == 1, \"anchor must be input 1\");\n        require(tx.inputs[0].tokenCategory == planCategory + 0x02, \"input 0 must be plan minting NFT\");\n        require(tx.inputs[1].tokenCategory == planCategory, \"anchor must hold plan none NFT\");\n\n        bytes commitment = tx.inputs[1].nftCommitment;\n        require(commitment.length == 8, \"invalid anchor commitment length\");\n        bytes seqBytes = commitment.split(4)[1];\n        int reviewSequence = int(seqBytes);\n        require(reviewSequence >= 4194305 && reviewSequence <= 4259839, \"reviewSequence must be valid time-based BIP68\");\n        require(tx.version >= 2, \"tx version must be >= 2 for BIP68 CSV\");\n        require(this.age >= reviewSequence, \"review delay has not elapsed\");\n    }\n\n    function cancel() {\n        require(this.activeInputIndex == 1, \"anchor must be input 1\");\n        require(tx.inputs[0].tokenCategory == planCategory + 0x02, \"input 0 must be plan minting NFT\");\n        require(tx.inputs[1].tokenCategory == planCategory, \"anchor must hold plan none NFT\");\n        require(tx.inputs.length >= 3, \"owner co-spend input required\");\n        require(tx.inputs[2].lockingBytecode == new LockingBytecodeP2PKH(ownerPkh), \"input 2 must be owner\");\n        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, \"cancel must return to plan\");\n        require(tx.outputs[0].tokenCategory == planCategory + 0x02, \"cancel must preserve plan minting NFT\");\n\n        bytes state = tx.inputs[0].nftCommitment;\n        require(state.length == 51, \"invalid plan commitment length\");\n        bytes header, bytes afterHeader = state.split(2);\n        require(header == 0x0201, \"cancel requires REVIEW\");\n        bytes round = afterHeader.split(4)[0];\n        bytes marker = tx.inputs[1].nftCommitment;\n        require(marker.length == 8, \"invalid anchor commitment length\");\n        require(marker.split(4)[0] == round, \"anchor round mismatch\");\n\n        int nextRound = int(round) + 1;\n        require(nextRound > 0 && nextRound < 2147483647, \"round overflow\");\n        bytes successor = tx.outputs[0].nftCommitment;\n        require(successor.length == 51, \"invalid successor commitment length\");\n        require(successor.split(7)[0] == 0x0200 + toPaddedBytes(nextRound, 4) + 0x00, \"cancel requires next ACTIVE round with no approvals\");\n    }\n}\n",
